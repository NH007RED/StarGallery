<?xml version="1.0" encoding="utf-8"?>
<!-- Original StarGallery mark: a portrait frame (rounded rectangle outline with corner brackets) holding a minimalist five-point star. Content stays inside the 66dp adaptive safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Portrait frame -->
    <path
        android:pathData="M36,30 L72,30 Q76,30 76,34 L76,74 Q76,78 72,78 L36,78 Q32,78 32,74 L32,34 Q32,30 36,30 Z"
        android:strokeWidth="2.6"
        android:strokeLineJoin="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="32"
                android:startY="30"
                android:endX="76"
                android:endY="78"
                android:type="linear">
                <item android:color="#F472B6" android:offset="0.0" />
                <item android:color="#C4B5FD" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Cinematic corner ticks -->
    <path
        android:pathData="M28,40 L28,26 L42,26 M80,40 L80,26 L66,26 M28,68 L28,82 L42,82 M80,68 L80,82 L66,82"
        android:strokeColor="#22D3EE"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />

    <!-- Star -->
    <path
        android:pathData="M54,38 L58.2,48.6 L69.6,49.4 L60.8,56.7 L63.6,67.8 L54,61.7 L44.4,67.8 L47.2,56.7 L38.4,49.4 L49.8,48.6 Z"
        android:strokeLineJoin="round"
        android:strokeWidth="1.2"
        android:strokeColor="#FFFFFF">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="40"
                android:startY="38"
                android:endX="68"
                android:endY="68"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#DDD6FE" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
